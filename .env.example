# Application
APP_PORT=3000
APP_ENV=development
# Proxy hops to trust for the client IP (X-Forwarded-For). Set to 1 behind
# Nginx; leave unset when the API is reached directly.
TRUST_PROXY=

# Database (local Docker PostgreSQL — see docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/vyzi
DB_SSL=false
# Keep the schema in sync with the entities on boot. Always on in development;
# set to true in production, since the project has no migrations.
DB_SYNCHRONIZE=false

# Database (NeonDB — for production/staging)
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/vyzi?sslmode=require
# DB_SSL=true

# JWT
JWT_SECRET=CHANGE_ME__openssl_rand_hex_32
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=CHANGE_ME__openssl_rand_hex_32__different_from_above
JWT_REFRESH_EXPIRES_IN=7d

# File Upload
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=10485760

# Browser origins allowed to call the API (comma-separated). Required in
# production: without it the dashboard is blocked. Unset in development
# allows every origin.
CORS_ORIGINS=http://localhost:3001

# Frontend URLs
FRONTEND_URL=http://localhost:3001
# Admin dashboard origin. Web-push notifications open here.
# Falls back to FRONTEND_URL when unset.
DASHBOARD_URL=http://localhost:3001
MOBILE_APP_SCHEME=vyzi

# Email — SMTP
# Every environment sends through a real SMTP relay; there is no separate
# dev transport. Leave SMTP_HOST empty in development to print OTP codes to
# the console instead of delivering them.
#
# Gmail / Google Workspace needs 2-Step Verification on the account, then an
# App Password from myaccount.google.com > Security > App passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false                   # true only on port 465 (implicit TLS)
SMTP_USER=no-reply@vyzi.it
SMTP_PASSWORD=xxxxxxxxxxxxxxxx      # 16-char app password, spaces are ignored

# Gmail rewrites From to SMTP_USER unless the address is a verified
# "Send mail as" alias on that account. Leave empty to send as SMTP_USER.
EMAIL_FROM=
# EMAIL_REPLY_TO=support@vyzi.it

# Optional overrides — the defaults are correct for Gmail and most relays.
# SMTP_REQUIRE_TLS=true             # default: true whenever SMTP_USER is set
# SMTP_REJECT_UNAUTHORIZED=false    # only for a relay with a self-signed cert

# Other providers, for reference:
#   Brevo     smtp-relay.brevo.com  587  SECURE=false
#   SendGrid  smtp.sendgrid.net     587  SECURE=false  USER=apikey
#   Zoho EU   smtp.zoho.eu          465  SECURE=true
#   Aruba     smtps.aruba.it        465  SECURE=true

# OTP
OTP_EXPIRY_MINUTES=10

# Firebase (Social Login)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# AI / OCR (OpenAI Vision API)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
OCR_MODEL=gpt-4o
OCR_MAX_TOKENS=4096
# Legacy (unused): ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Deep Linking
BACKEND_DOMAIN=https://api.vyzi.it
ANDROID_SHA256_FINGERPRINT=XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX
APPLE_TEAM_ID=XXXXXXXXXX
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.vyzi
APP_STORE_URL=https://apps.apple.com/app/vyzi/idXXXXXXXXXX

# Admin Seed
ADMIN_EMAIL=admin@vyzi.it
ADMIN_PASSWORD=ChangeThisSecurePassword123!
